# Safe local defaults. Copy to .env.local; never commit real credentials.
UTOM_OFFLINE_MODE=true
UTOM_V2_ENABLED=false
UTOM_PAID_AI_ENABLED=false
AI_PROVIDER=mock
REAL_AI_ENABLED=false
BACKGROUND_JOBS_ENABLED=false
FEED_FETCH_ENABLED=false
EMAIL_SEND_ENABLED=false
DB_WRITE_ENABLED=false
VIDEO_GENERATION_ENABLED=false
PAYMENT_ENABLED=false

# Server-only secrets and connection data. Leave blank in offline development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=utom_dev
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
EMAIL_OUTBOX_ENCRYPTION_KEY=

# Public values may be included in the browser bundle. Never put secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_LOCAL_DEMO_CAPTCHA=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
UTOM_INTERNAL_BASE_URL=http://127.0.0.1:3000
UTOM_ALLOWED_ORIGIN=http://localhost:3000
UTOM_TRUST_PROXY_HEADERS=false
UTOM_LOCAL_DEMO_CAPTCHA=false
UTOM_API_KEY=
UTOM_INTERNAL_WORKER_TOKEN=
VIDEO_SIGN_SECRET=
VIDEO_INPUT_DIR=/var/www/utom/private/videos
FFMPEG_PATH=ffmpeg
AI_STEP_MAX_ATTEMPTS=1
ARTICLE_CLAIM_STALE_MS=900000
ARTICLE_MAX_ATTEMPTS=3
UTOM_WORKER_ID=

# Optional, explicit local-only schema migrations; do NOT enable in normal app runtime.
# Create an EMPTY MySQL 8 database manually, e.g. utom_dev.
DB_MIGRATION_ENABLED=false
