# Safe local defaults. Copy to .env.local; never commit real credentials.
UTOM_OFFLINE_MODE=true
UTOM_V2_ENABLED=false
UTOM_PAID_AI_ENABLED=false
AI_PROVIDER=mock
REAL_AI_ENABLED=false
BACKGROUND_JOBS_ENABLED=false
FEED_FETCH_ENABLED=false
EMAIL_SEND_ENABLED=false
DB_WRITE_ENABLED=false
VIDEO_GENERATION_ENABLED=false
PAYMENT_ENABLED=false

# Server-only secrets and connection data. Leave blank in offline development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=utom_dev
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
EMAIL_OUTBOX_ENCRYPTION_KEY=

# Public values may be included in the browser bundle. Never put secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_LOCAL_DEMO_CAPTCHA=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Production: comma-separated hostnames accepted from Google siteverify (for example utom.hu,www.utom.hu).
RECAPTCHA_ALLOWED_HOSTNAMES=
UTOM_INTERNAL_BASE_URL=http://127.0.0.1:3000
UTOM_ALLOWED_ORIGIN=http://localhost:3000
UTOM_TRUST_PROXY_HEADERS=false
UTOM_LOCAL_DEMO_CAPTCHA=false
UTOM_API_KEY=
UTOM_INTERNAL_WORKER_TOKEN=
VIDEO_SIGN_SECRET=
VIDEO_INPUT_DIR=/var/www/utom/private/videos
FFMPEG_PATH=ffmpeg
AI_STEP_MAX_ATTEMPTS=1
ARTICLE_CLAIM_STALE_MS=900000
ARTICLE_MAX_ATTEMPTS=3
UTOM_WORKER_ID=

# Optional, explicit local-only schema migrations; do NOT enable in normal app runtime.
# Create an EMPTY MySQL 8 database manually, e.g. utom_dev.
DB_MIGRATION_ENABLED=false

# Optional article illustrations. Disabled by default; values below are server-only.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_SEED=
IMAGE_GEN_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional compatibility alias used when CLOUDFLARE_AI_API_TOKEN is unset.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
IMAGE_GEN_DAILY_NEURON_BUDGET=8000
IMAGE_GEN_ESTIMATED_NEURONS=800
IMAGE_GEN_CONCURRENCY=1
IMAGE_GEN_MIN_ARTICLE_ID=
IMAGE_GEN_BACKFILL_EXISTING=false
IMAGE_WORKER_IDLE_MS=2000
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_TIMEOUT_MS=45000
IMAGE_GEN_WEBP_QUALITY=82
# Optional only. Leave disabled on legacy CPUs; validated JPEG/PNG/WebP bytes are stored unchanged.
IMAGE_GEN_OPTIMIZE_WITH_SHARP=false
IMAGE_GEN_CLAIM_STALE_MS=900000
IMAGE_GEN_CIRCUIT_FAILURES=3
IMAGE_GEN_CIRCUIT_COOLDOWN_MS=300000
IMAGE_GEN_STORAGE_ROOT=public/article-images
IMAGE_GEN_WORKER_ID=
RUN_CLOUDFLARE_IMAGE_SMOKE=0

# Bind the private video service to loopback; reverse proxy it through the public web server.
VIDEO_SERVER_HOST=127.0.0.1
VIDEO_SERVER_PORT=3001
