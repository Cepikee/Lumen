# Safe local defaults. Copy to .env.local; never commit real credentials.
UTOM_OFFLINE_MODE=true
AI_PROVIDER=mock
REAL_AI_ENABLED=false
BACKGROUND_JOBS_ENABLED=false
FEED_FETCH_ENABLED=false
EMAIL_SEND_ENABLED=false
DB_WRITE_ENABLED=false
VIDEO_GENERATION_ENABLED=false
PAYMENT_ENABLED=false

# Server-only secrets and connection data. Leave blank in offline development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=projekt2025
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Public values may be included in the browser bundle. Never put secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
